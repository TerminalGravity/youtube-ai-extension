{
  "manifest": {
    "name": "YouTube AI",
    "version": "0.0.1",
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "tabs"
    ],
    "host_permissions": ["*://*.youtube.com/*"],
    "web_accessible_resources": [
      {
        "resources": ["options.html", "*.js", "*.css"],
        "matches": ["<all_urls>"]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    }
  }
} 